// ---- type kinds -------------------------------------------------------

I64 TY_U0 = 0;
I64 TY_U8 = 1;
I64 TY_U16 = 2;
I64 TY_U32 = 3;
I64 TY_U64 = 4;
I64 TY_I8 = 5;
I64 TY_I16 = 6;
I64 TY_I32 = 7;
I64 TY_I64 = 8;
I64 TY_F64 = 9;
I64 TY_BOOL = 10;
I64 TY_STR = 11;
I64 TY_AUTO = 12;
I64 TY_CLASST = 13;

// ---- capacity limits ----------------------------------------------

I64 MAX_TOKENS = 50000;
I64 MAX_NODES_PER_LIST = 4096;

// ---- tokens -----------------------------------------------------------

class Token {
    I64 kind;
    U8* text;
    I64 ival;
    F64 fval;
    I64 line;

    U0 Token() {
        this.text = "";
        this.ival = 0;
        this.fval = 0.0;
        this.line = 0;
    }
};

class TokenList {
    Token items[50000];
    I64 count;

    U0 TokenList() {
        this.count = 0;
    }

    U0 Push(Token t) {
        this.items[this.count] = t;
        this.count++;
    }

    Token Get(I64 i) {
        return this.items[i];
    }
};

// ---- AST nodes -------------------------------------------------------
//
// One node shape covers every expression and statement kind, tagged by
// "kind". Which fields matter depends on kind, see docs/language_spec
// for the surface grammar and bootstrap/hcrun.c for the twin
// implementation this one mirrors.

class NodeList {
    Node items[4096];
    I64 count;

    U0 NodeList() {
        this.count = 0;
    }

    U0 Push(Node n) {
        this.items[this.count] = n;
        this.count++;
    }

    Node Get(I64 i) {
        return this.items[i];
    }
};

class Node {
    I64 kind;
    I64 line;

    I64 ival;
    F64 fval;
    U8* sval;
    U8* sval2;
    Bool bval;

    I64 type_kind;
    U8* type_class_name;
    I64 array_size;

    Node a;
    Node b;
    Node c;
    Node d;

    NodeList list1;
    NodeList list2;

    U0 Node() {
        this.sval = "";
        this.sval2 = "";
        this.type_class_name = "";
        this.array_size = 0;
        this.list1 = NodeList();
        this.list2 = NodeList();
    }
};

// A parsed program: every class, free function and global variable
// declaration, in source order. Classes are always reference types in
// HolyC++, so passing a Program into ParseTopLevel and mutating its
// lists there is visible to the caller, there is no need for output
// parameters or a return value carrying three separate lists.

class Program {
    NodeList classes;
    NodeList funcs;
    NodeList globals;

    U0 Program() {
        this.classes = NodeList();
        this.funcs = NodeList();
        this.globals = NodeList();
    }
};

