// Fixed size arrays, array literals, and the Len builtin.

U0 Main() {
    I64 primes[6] = {2, 3, 5, 7, 11, 13};
    I64 i;
    I64 sum = 0;

    for (i = 0; i < Len(primes); i++) {
        Print("primes[%d] = %d\n", i, primes[i]);
        sum += primes[i];
    }
    Print("sum = %d\n", sum);

    // A declared but uninitialized array is zero filled.
    I64 scores[5];
    for (i = 0; i < Len(scores); i++) scores[i] = i * i;
    for (i = 0; i < Len(scores); i++) Print("scores[%d] = %d\n", i, scores[i]);
}
